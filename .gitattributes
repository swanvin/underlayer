# Normalize text files to LF in repo
* text=auto eol=lf

# Explicit common types
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows scripts keep CRLF (if you have them)
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary

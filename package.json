{
    "name":  "underlayer",
    "version":  "0.1.4",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev --webpack",
                    "dev:turbo":  "next dev --turbo",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "eslint",
                    "underlayer:export":  "pnpm exec tsx tools/export.ts",
                    "underlayer:gate":  "pnpm i \u0026\u0026 pnpm run underlayer:export \u0026\u0026 pnpm run lint \u0026\u0026 pnpm run build",
                    "underlayer:check":  "pnpm run lint \u0026\u0026 pnpm run build",
                    "underlayer:ready":  "node -e \"const {execSync}=require(\u0027child_process\u0027); const sh=(c)=\u003eexecSync(c,{stdio:\u0027inherit\u0027}); const out=(c)=\u003eexecSync(c,{stdio:[\u0027ignore\u0027,\u0027pipe\u0027,\u0027pipe\u0027]}).toString().trim(); sh(\u0027pnpm run underlayer:gate\u0027); const s=out(\u0027git status --porcelain\u0027); if(s){ console.error(\u0027WORKTREE_DIRTY\u0027); process.exit(1);} console.log(\u0027OK_READY_TO_TAG\u0027);\"",
                    "underlayer:release:patch":  "node tools/release.mjs patch",
                    "underlayer:release:minor":  "node tools/release.mjs minor",
                    "underlayer:release:major":  "node tools/release.mjs major",
                    "underlayer:release":  "pnpm run underlayer:release:patch"
                },
    "dependencies":  {
                         "next":  "16.1.1",
                         "react":  "19.2.3",
                         "react-dom":  "19.2.3"
                     },
    "devDependencies":  {
                            "@eslint/eslintrc":  "^3.3.3",
                            "@tailwindcss/postcss":  "^4",
                            "@types/node":  "^20",
                            "@types/react":  "^19",
                            "@types/react-dom":  "^19",
                            "eslint":  "^9",
                            "eslint-config-next":  "16.1.1",
                            "tailwindcss":  "^4",
                            "ts-node":  "^10.9.2",
                            "tsx":  "^4.21.0",
                            "typescript":  "^5"
                        }
}
